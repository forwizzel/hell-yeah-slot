{
  "name": "hell-yeah",
  "version": "1.0.0",
  "description": "Browser slot game with reel-strip math, PixiJS presentation, and seeded simulation",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "analyze": "tsx src/simulation/analyzeReels.ts",
    "simulate": "tsx src/simulation/runSimulation.ts"
  },
  "keywords": [
    "pixijs",
    "typescript",
    "slot-game"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
